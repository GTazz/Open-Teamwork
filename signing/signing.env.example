# Copie para signing/signing.env e preencha. Usado por "npm run mobile:secrets",
# que envia a chave para os secrets do GitHub (o workflow do APK assina com ela).
# O .jks e o signing.env ficam fora do git (.gitignore).
ANDROID_KEYSTORE_FILE=signing/open-teamwork-release.jks
ANDROID_KEYSTORE_PASSWORD=troque-pela-senha-da-chave
ANDROID_KEY_ALIAS=open-teamwork
