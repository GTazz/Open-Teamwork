erDiagram
    USER ||--|| PROFILE : owns
    USER ||--o{ PROJECT : creates
    PROJECT ||--o{ PROJECT_QUALIFICATION : defines
    USER ||--o{ APPLICATION : submits
    PROJECT ||--o{ APPLICATION : receives
    PROJECT_QUALIFICATION ||--|| APPLICATION : receives

    USER {
      int id PK

      string email
      string nick UK
      string password_hash
    }

    PROFILE {
      int id PK, FK

      string name
      string contact_email
      string phone
      string bio
      string avatar_url
      string github_url
      string linkedin_url
      string website_url
    }

    PROJECT {
      int id PK
      
      int user_id FK

      string name
      string description
      string url
      string tags
    }

    PROJECT_QUALIFICATION {
      int id PK, FK
      int project_id PK, FK

      string name
      int total_slots
      int filled_slots
    }

    APPLICATION {
      int id PK, FK
      int project_id PK, FK
      int user_id FK
      int qualification_id FK

      string status
    }