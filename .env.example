# Copie para .env e preencha (o arquivo .env NUNCA deve ir para o GitHub).

PORT=3000

# Chave usada para assinar os logins. Gere uma aleatória com pelo menos 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-de-32-caracteres

# ---- Banco de dados ----------------------------------------------------------
# Desenvolvimento local: um arquivo SQLite (não precisa configurar mais nada).
DATABASE_FILE=./data/open-teamwork.sqlite

# Produção gratuita: banco Turso (persistente). Se estas duas linhas estiverem
# preenchidas, o app usa o Turso e ignora DATABASE_FILE.
# TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
# TURSO_AUTH_TOKEN=

# ---- E-mail (confirmação de cadastro e recuperação de senha) ----------------
# Conta gratuita em https://www.brevo.com (300 e-mails/dia). Crie uma chave em
# SMTP & API > API Keys e confirme o remetente em Senders. Sem a chave, em
# desenvolvimento os códigos aparecem no terminal; em produção o envio falha.
# BREVO_API_KEY=
# MAIL_FROM=voce@seudominio.com
# MAIL_FROM_NAME=GTazz Projects

# ---- Opcional ----------------------------------------------------------------
# Endereços extras autorizados a chamar a API de outro site (separados por vírgula).
# O app mobile (Capacitor) já é autorizado por padrão.
# CORS_ORIGINS=https://meu-dominio.com

# Painel admin (pages/admin.html). Gere o hash com:
# node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 12))"
# Sem ADMIN_PASSWORD_HASH o painel fica desativado.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
